# Installed as /etc/caddy/Caddyfile by setup-server.sh; Caddy gets the TLS
# certificate itself once the domain's A record points at this server.
{$SUDOKU_DOMAIN} {
	encode zstd gzip
	request_body {
		max_size 11MB
	}
	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		-Server
	}
	reverse_proxy 127.0.0.1:8000
}
