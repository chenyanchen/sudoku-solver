# Installed as /etc/caddy/Caddyfile by setup-server.sh. The domain is proxied by
# Cloudflare; Caddy gets a Let's Encrypt certificate through it (HTTP-01), so
# Cloudflare's SSL mode can be "Full (strict)".
#
# Only Cloudflare may connect (https://www.cloudflare.com/ips/), which makes its
# CF-Connecting-IP header trustworthy: the app rate-limits by that client IP.
# Turning Cloudflare's proxy off therefore takes the site offline.
(cloudflare) {
	@direct not remote_ip 173.245.48.0/20 103.21.244.0/22 103.22.200.0/22 103.31.4.0/22 141.101.64.0/18 108.162.192.0/18 190.93.240.0/20 188.114.96.0/20 197.234.240.0/22 198.41.128.0/17 162.158.0.0/15 104.16.0.0/13 104.24.0.0/14 172.64.0.0/13 131.0.72.0/22 2400:cb00::/32 2606:4700::/32 2803:f800::/32 2405:b500::/32 2405:8100::/32 2a06:98c0::/29 2c0f:f248::/32
	abort @direct
}

{$SUDOKU_DOMAIN} {
	import cloudflare
	encode zstd gzip
	request_body {
		max_size 11MB
	}
	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		-Server
	}
	reverse_proxy 127.0.0.1:8000 {
		header_up X-Forwarded-For {http.request.header.CF-Connecting-IP}
	}
}
